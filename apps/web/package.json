    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "vitest": "^3.2.4"
  }
}
