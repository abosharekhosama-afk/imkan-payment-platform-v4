NODE_ENV=development
APP_ENV=sandbox
PORT=3000
# Legacy MySQL (retained — DEC-014). Do not delete.
DATABASE_URL=mysql://payment:payment@127.0.0.1:3306/payment_platform
# V4 primary PostgreSQL system of record
DATABASE_URL_PG=postgres://imkan:imkan@127.0.0.1:5432/imkan_payments
REDIS_URL=redis://127.0.0.1:6379
API_BASE_URL=http://localhost:3000
CHECKOUT_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
ENABLE_LEGACY_V1=true
REQUIRE_EMAIL_VERIFICATION=false
EXPOSE_DEV_TOKENS=true
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_INTERVAL_MS=2000

WEBHOOK_SIGNING_SECRET=dev-webhook-secret

# Phase 3 — bank/identification data protection (env only; NEVER stored in the database).
# Production refuses to start with dev fallbacks (see config.ts requiredInProduction).
BANK_DATA_ENCRYPTION_KEY=dev-only-bank-data-key-change-me-0001
BANK_FINGERPRINT_HMAC_KEY=dev-only-bank-fingerprint-key-0001

# Optional real processor adapter. Leave unset for sandbox.
PROCESSOR_BASE_URL=
PROCESSOR_API_KEY=
PROCESSOR_NAME=remote

# Payment processor: sandbox | remote | paytabs
PAYMENT_PROVIDER=sandbox
# P16: in NODE_ENV=production, magic tok_* tokens blocked unless true (staging internal sandbox only)
ALLOW_SANDBOX_TOKENS_IN_PRODUCTION=false

# P16.1 — Email delivery (vendor-neutral SMTP; stub in development)
EMAIL_TRANSPORT=stub
APP_PUBLIC_URL=http://localhost:5173
EMAIL_FROM=noreply@example.test
EMAIL_FROM_NAME=IMKAN Payments
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# P16.3 — KYB document storage (local filesystem or S3-compatible)
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=.storage/documents
# For S3/MinIO: DOCUMENT_STORAGE_BACKEND=s3, S3_BUCKET=, S3_REGION=, S3_ACCESS_KEY_ID=, S3_SECRET_ACCESS_KEY=
# Optional: S3_ENDPOINT=http://127.0.0.1:9000
PLATFORM_KYB_NOTIFY_EMAIL=

# PayTabs V4 adapter (P15.3/P15.4) — SANDBOX ONLY (GCC path: docs/providers/GCC_PAYTABS_ACTIVATION.md)
PAYTABS_ENV=sandbox
PAYTABS_ADAPTER_MODE=simulate
# Set true + provide credentials below to run real sandbox HTTP certification (P15.4/P15.5)
PAYTABS_REAL_SANDBOX_CERT=false
# Public HTTPS URL where PayTabs can deliver callbacks (required for P15.5 E2E)
PAYTABS_REAL_WEBHOOK_ENDPOINT=
# Regional base URL — use the endpoint from your PayTabs dashboard, e.g.:
#   SA:  https://secure.paytabs.sa
#   UAE: https://secure.paytabs.com
#   EG:  https://secure-egypt.paytabs.com
#   OM:  https://secure-oman.paytabs.com
#   JO:  https://secure-jordan.paytabs.com
PAYTABS_SANDBOX_BASE_URL=https://secure-egypt.paytabs.com
PAYTABS_SANDBOX_PROFILE_ID=
PAYTABS_SANDBOX_SERVER_KEY=
# Must be public HTTPS for real PayTabs callbacks (localhost blocks E2E readiness)
PAYTABS_SANDBOX_CALLBACK_URL=http://localhost:3000/api/v1/webhooks/providers/paytabs
PAYTABS_SANDBOX_RETURN_URL=http://localhost:5173/checkout/return

# Stripe V4 adapter (Checkout Session — test + live planes)
# Docs: docs/providers/STRIPE_V4_ADAPTER.md
STRIPE_ADAPTER_MODE=http
STRIPE_ENV=test
STRIPE_CHECKOUT_UI=elements
STRIPE_AUTO_ROUTE=true
STRIPE_ALLOW_LIVE=false
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
# Live (requires STRIPE_ALLOW_LIVE=true + sk_live_ keys)
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/checkout/return?status=success
STRIPE_CANCEL_URL=http://localhost:5173/checkout/return?status=cancel

# See docs/ops/PAYMENT_PRODUCTION_CLOSURE.md and docs/ops/PRODUCTION_DEPLOY_RUNBOOK.md
# Copy .env.production.example → .env.production on server, then: npm run ops:production-preflight
# NODE_ENV=production
# APP_ENV=production
# REDIS_URL=redis://127.0.0.1:6379
# RATE_LIMIT_STORE=redis
# SESSION_TRANSPORT=cookie
# OUTBOX_WORKER_ENABLED=true
# PAYMENT_PROVIDER=stripe
# REQUIRE_KYB_FOR_PAYMENTS=true
# REQUIRE_EMAIL_VERIFICATION=true
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# APP_PUBLIC_URL=https://your-app.example
# CORS_ORIGIN=https://your-app.example
# TRUST_PROXY=true
# STRIPE_ENV=live
# STRIPE_ALLOW_LIVE=true
# STRIPE_AUTO_ROUTE=false
# STRIPE_CHECKOUT_UI=elements
# STRIPE_LIVE_SECRET_KEY=sk_live_...
# STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_LIVE_WEBHOOK_SECRET=whsec_...
# Merchant Books notify: Developers → Outbound Webhooks (docs/books/BOOKS_PAYMENT_LINK_FLOW.md)
# Legacy PayTabs env (pre-V4 adapter — do not use for P15.3+)
PAYTABS_BASE_URL=https://secure.paytabs.com
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_CALLBACK_URL=http://localhost:3000/v1/webhooks/provider/paytabs
PAYTABS_RETURN_URL=http://localhost:5173/payment/return

# Zoho Books OAuth
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_BOOKS_API_URL=https://www.zohoapis.com/books/v3
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REDIRECT_URI=http://localhost:3000/v1/integrations/zoho-books/oauth/callback
ZOHO_BOOKS_SCOPES=ZohoBooks.contacts.CREATE,ZohoBooks.contacts.READ,ZohoBooks.invoices.READ,ZohoBooks.customerpayments.CREATE,ZohoBooks.customerpayments.READ,ZohoBooks.settings.READ
