
# Processor selection. Keep sandbox for development; use paytabs only after merchant onboarding and credentials.
PAYMENT_PROVIDER=paytabs
PAYTABS_BASE_URL=https://secure.paytabs.com
PAYTABS_PROFILE_ID=YOUR_PROFILE_ID
PAYTABS_SERVER_KEY=YOUR_SERVER_KEY
PAYTABS_CALLBACK_URL=https://api.example.com/v1/webhooks/provider/paytabs
PAYTABS_RETURN_URL=https://app.example.com/payment/return

ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_BOOKS_API_URL=https://www.zohoapis.com/books/v3
ZOHO_BOOKS_CLIENT_ID=YOUR_ZOHO_CLIENT_ID
ZOHO_BOOKS_CLIENT_SECRET=YOUR_ZOHO_CLIENT_SECRET
ZOHO_BOOKS_REDIRECT_URI=https://api.example.com/v1/integrations/zoho-books/oauth/callback
ZOHO_BOOKS_SCOPES=ZohoBooks.contacts.CREATE,ZohoBooks.contacts.READ,ZohoBooks.invoices.READ,ZohoBooks.customerpayments.CREATE,ZohoBooks.customerpayments.READ,ZohoBooks.settings.READ

# Production authentication/security
SESSION_TTL_HOURS=24
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
TRUST_PROXY=true
LOG_LEVEL=info

# Optional external KYC/KYB, fraud/risk, settlement and payout adapters.
KYC_PROVIDER_URL=
KYC_PROVIDER_KEY=
RISK_PROVIDER_URL=
RISK_PROVIDER_KEY=
SETTLEMENT_PROVIDER_URL=
SETTLEMENT_PROVIDER_KEY=
PAYOUT_PROVIDER_URL=
PAYOUT_PROVIDER_KEY=
DEFAULT_REGION=SA
