# =============================================================================
# Payment Platform V4 — Production environment template
# Copy to .env on the API host (never commit secrets).
# Validate before deploy: npm run ops:production-preflight
# Runbook: docs/ops/PRODUCTION_DEPLOY_RUNBOOK.md
# =============================================================================

# --- Core ---
NODE_ENV=production
APP_ENV=production
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true

# --- PostgreSQL (V4 system of record) ---
# Use a managed PostgreSQL 16+ instance with TLS in production.
DATABASE_URL_PG=postgres://USER:PASSWORD@db.example.com:5432/imkan_payments?sslmode=require
POSTGRES_URL=

# Legacy MySQL — keep unset unless ENABLE_LEGACY_V1=true (not recommended)
DATABASE_URL=
ENABLE_LEGACY_V1=false

# --- Redis (required in production) ---
REDIS_URL=redis://:PASSWORD@redis.example.com:6379/0
RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_PREFIX=rl:
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# --- Public URLs / CORS / HTTPS ---
APP_PUBLIC_URL=https://app.example.com
CHECKOUT_BASE_URL=https://app.example.com
API_BASE_URL=https://api.example.com
CORS_ORIGIN=https://app.example.com

# --- Sessions & security ---
SESSION_TRANSPORT=cookie
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# --- Workers ---
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_INTERVAL_MS=2000
BILLING_RENEWAL_WORKER_ENABLED=false

# --- Email (required — verification, invites, KYB) ---
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_TRANSPORT=smtp
EMAIL_FROM=payments@example.com
EMAIL_FROM_NAME=IMKAN Payments
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- KYB gate (blocks payment links until approved) ---
REQUIRE_KYB_FOR_PAYMENTS=true

# --- Payment provider ---
PAYMENT_PROVIDER=stripe
ALLOW_SANDBOX_TOKENS_IN_PRODUCTION=false

# --- Stripe Live ---
STRIPE_ADAPTER_MODE=http
STRIPE_ENV=live
STRIPE_ALLOW_LIVE=true
STRIPE_AUTO_ROUTE=false
STRIPE_CHECKOUT_UI=elements
STRIPE_LIVE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_LIVE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_SUCCESS_URL=https://app.example.com/checkout/return?status=success
STRIPE_CANCEL_URL=https://app.example.com/checkout/return?status=cancel

# --- Secrets (generate strong random values — never use dev fallbacks) ---
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARS
SANDBOX_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARS
PAYMENT_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_KEY
BANK_DATA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_KEY
BANK_FINGERPRINT_HMAC_KEY=REPLACE_WITH_32_BYTE_KEY

# --- Secret backend ---
SECRET_BACKEND=env
# SECRET_BACKEND=file
# SECRET_FILE_PATH=/run/secrets/imkan.json

# --- Document storage (KYB uploads) ---
DOCUMENT_STORAGE_BACKEND=s3
S3_BUCKET=imkan-kyb-prod
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=   # MinIO / compatible only

# --- Platform ops ---
PLATFORM_KYB_NOTIFY_EMAIL=kyb-review@example.com
DEFAULT_REGION=SA

# --- Optional: disable dev-only behaviour ---
EXPOSE_DEV_TOKENS=false

# Stripe Dashboard inbound webhook (configure manually):
#   POST https://api.example.com/api/v1/webhooks/providers/stripe
#   Events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
#
# Merchant outbound webhook (Books) — register in console or via API after deploy.
# See docs/books/BOOKS_PAYMENT_LINK_FLOW.md
